{
  "name": "protostar",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts/*"
    ],
    "catalog": {
      "@t3-oss/env-core": "^0.13.10",
      "consola": "^3.4.2",
      "eslint": "^10.0.2",
      "neverthrow": "^8.2.0",
      "serialize-error": "^13.0.1",
      "typescript": "^5.9.3",
      "vite": "^7.3.1",
      "zod": "^4.3.6"
    },
    "catalogs": {
      "types": {
        "@types/bun": "^1.3.9",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3"
      },
      "ui": {
        "@tailwindcss/vite": "^4.2.1",
        "@vitejs/plugin-react": "^5.1.4",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwindcss": "^4.2.1"
      }
    }
  },
  "scripts": {
    "web:dev": "bun --filter @protostar/web dev",
    "check-types": "bun run --parallel --workspaces --if-present --no-exit-on-error check-types",
    "lint": "bun run --parallel --workspaces --if-present --no-exit-on-error lint",
    "lint:fix": "bun run --parallel --workspaces --if-present --no-exit-on-error lint:fix",
    "format": "bunx prettier . --write",
    "format:check": "bunx prettier . --check",
    "check": "bun run check-types && bun run lint && bun run format:check",
    "sync-hooks": "bunx lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.1",
    "prettier": "3.8.1",
    "prettier-plugin-curly": "0.4.1"
  }
}
