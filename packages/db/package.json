{
  "name": "@protostar/db",
  "type": "module",
  "private": true,
  "scripts": {
    "try": "bun run test/try.ts",
    "check-types": "bunx tsc --noEmit",
    "lint": "bunx eslint --cache",
    "lint:fix": "bunx eslint --cache --fix",
    "check": "bun run check-types && bun run lint",
    "push": "bunx drizzle-kit push",
    "generate": "bunx drizzle-kit generate",
    "migrate": "bunx drizzle-kit migrate",
    "studio": "bunx drizzle-kit studio",
    "seed": "bun run src/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@t3-oss/env-core": "catalog:",
    "consola": "catalog:",
    "drizzle-orm": "^0.45.1",
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@protostar/eslint-config": "workspace:*",
    "@protostar/typescript-config": "workspace:*",
    "@types/bun": "catalog:types",
    "drizzle-kit": "^0.31.9",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
