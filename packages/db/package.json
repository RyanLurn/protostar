{
  "name": "@protostar/db",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bunx tsdown --watch",
    "build": "bunx tsdown",
    "try": "bun run test/try.ts",
    "check-types": "bunx tsc --noEmit",
    "lint": "bunx eslint --cache",
    "lint:fix": "bunx eslint --cache --fix",
    "check": "bun run check-types && bun run lint",
    "push": "bunx --bun drizzle-kit push",
    "generate": "bunx --bun drizzle-kit generate",
    "migrate": "bunx --bun drizzle-kit migrate",
    "studio": "bunx --bun drizzle-kit studio",
    "seed": "bun run src/seed.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/lib.mjs",
      "types": "./dist/lib.d.mts"
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@t3-oss/env-core": "catalog:",
    "consola": "catalog:",
    "drizzle-orm": "^0.45.1"
  },
  "peerDependencies": {
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@protostar/eslint-config": "workspace:*",
    "@protostar/typescript-config": "workspace:*",
    "@types/bun": "catalog:types",
    "drizzle-kit": "^0.31.9",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
