{
  "name": "@protostar/web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bunx --bun vite",
    "check-types": "bunx tsc --noEmit",
    "lint": "bunx eslint --cache",
    "lint:fix": "bunx eslint --cache --fix",
    "check": "bun run check-types && bun run lint",
    "ui:add": "bunx --bun shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@protostar/api": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "catalog:ui",
    "react-dom": "catalog:ui",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@protostar/eslint-config": "workspace:*",
    "@protostar/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:ui",
    "@types/bun": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:ui",
    "eslint": "catalog:",
    "shadcn": "^3.8.5",
    "tailwindcss": "catalog:ui",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
